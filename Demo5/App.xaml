<Application x:Class="Demo5.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Demo5"
             xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="DarkColorBack" PresentationOptions:Freeze="True">#1E2022</SolidColorBrush>
        <SolidColorBrush x:Key="DarkColorLine" PresentationOptions:Freeze="True">#2C2E33</SolidColorBrush>
        <SolidColorBrush x:Key="DarkColorNodeBack" PresentationOptions:Freeze="True">#2A2C32</SolidColorBrush>
        <SolidColorBrush x:Key="DarkColorNodeTitle" PresentationOptions:Freeze="True">#E65F2B</SolidColorBrush>
        <SolidColorBrush x:Key="DarkColorNodeTitle2" PresentationOptions:Freeze="True">#7B1FA2</SolidColorBrush>
        <SolidColorBrush x:Key="DarkColorNodeTitle3" PresentationOptions:Freeze="True">#D32F2F</SolidColorBrush>
        <SolidColorBrush x:Key="LineColor1" PresentationOptions:Freeze="True">#00E5FF</SolidColorBrush>
        <SolidColorBrush x:Key="LineColor2" PresentationOptions:Freeze="True">#FFEA00</SolidColorBrush>

        <DrawingImage x:Key="DeleteNodeIcon" PresentationOptions:Freeze="True">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#33D32F2F">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="10,10" RadiusX="10" RadiusY="10"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FF4444" Thickness="2"></Pen>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="6,6" EndPoint="14,14"/>
                                <LineGeometry StartPoint="14,6" EndPoint="6,14"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Application.Resources>
</Application>

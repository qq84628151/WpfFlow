<Window
    x:Class="Demo7.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:flow="clr-namespace:WpfFlow;assembly=WpfFlow"
    xmlns:local="clr-namespace:Demo7"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="1200"
    Height="900"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <flow:FlowChart>
            <flow:NodeLinkShape Effect="{StaticResource LinkEffect}" LineType="Bezier" Source="node1" Stroke="LightSeaGreen" StrokeThickness="1" Target="node2" />
            <flow:NodeLinkShape Effect="{StaticResource LinkEffect}" LineType="Bezier" Source="node1" Stroke="LightSeaGreen" StrokeThickness="1" Target="node3" />
            <flow:NodeLinkShape Effect="{StaticResource LinkEffect}" LineType="Bezier" Source="node1" Stroke="LightSeaGreen" StrokeThickness="1" Target="node4" />
            <flow:NodeLinkShape Effect="{StaticResource LinkEffect}" LineType="Bezier" Source="node1" Stroke="LightSeaGreen" StrokeThickness="1" Target="node5" />
            <flow:NodeLinkShape Effect="{StaticResource LinkEffect}" LineType="Bezier" Source="node1" Stroke="LightSeaGreen" StrokeThickness="1" Target="node6" />
            <flow:NodeLinkShape Effect="{StaticResource LinkEffect}" LineType="Bezier" Source="node1" Stroke="LightSeaGreen" StrokeThickness="1" Target="node7" />
            <flow:NodeLinkShape Effect="{StaticResource LinkEffect}" LineType="Bezier" Source="node1" Stroke="LightSeaGreen" StrokeThickness="1" Target="node8" />

            <flow:RectShape Fill="LightPink" NodeId="node1" Position="500, 350" Size="100, 100" />
            <flow:RectShape Fill="LightBlue" NodeId="node2" Position="800, 100" Size="100, 100" />
            <flow:RectShape Fill="LightBlue" NodeId="node3" Position="800, 350" Size="100, 100" />
            <flow:RectShape Fill="LightBlue" NodeId="node4" Position="800, 550" Size="100, 100" />

            <flow:RectShape Fill="LightCoral" NodeId="node6" Position="200, 100" Size="100, 100" />
            <flow:RectShape Fill="LightCoral" NodeId="node7" Position="200, 350" Size="100, 100" />
            <flow:RectShape Fill="LightCoral" NodeId="node8" Position="200, 550" Size="100, 100" />
        </flow:FlowChart>
    </Grid>
</Window>

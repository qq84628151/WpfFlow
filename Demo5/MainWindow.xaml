<Window
    x:Class="Demo5.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:flow="clr-namespace:WpfFlow;assembly=WpfFlow"
    xmlns:local="clr-namespace:Demo5"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="1200"
    Height="900"
    Loaded="Window_Loaded"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <flow:FlowChart Name="FlowChart" Background="{StaticResource DarkColorBack}" DragAddNewLink="FlowChart_DragAddNewLink">
            <flow:FlowChart.GridStyle>
                <flow:QuareGrid GridColor="{StaticResource DarkColorLine}" />
            </flow:FlowChart.GridStyle>
            <flow:FlowChart.DefaultNewLine>
                <flow:RectLinkShape LineType="Bezier" Stroke="{StaticResource LineColor1}" />
            </flow:FlowChart.DefaultNewLine>

            <flow:RectShape x:Name="flowRect0" Fill="{StaticResource DarkColorNodeBack}" NodeId="node1" Position="100, 100" RightPortPanel="StackPanel" Size="100, 120" Stroke="LightSkyBlue">
                <flow:RectShape.RightPort>
                    <flow:Port Margin="0,10,0,0" Type="Out" ValueType="Color">
                        <flow:Port.RenderTransform>
                            <TranslateTransform X="-4" Y="20" />
                        </flow:Port.RenderTransform>
                        <Ellipse x:Name="outJoin1" Width="8" Height="8" Fill="LightGreen" />
                    </flow:Port>
                </flow:RectShape.RightPort>
                <Grid Width="100" Height="120">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border Width="100" Height="20" Background="{StaticResource DarkColorNodeTitle}" CornerRadius="5,5,0,0">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="White" Text="颜色" />
                    </Border>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="color1" VerticalContentAlignment="Center" Checked="color_Checked" Cursor="Arrow" GroupName="color" IsChecked="True">
                                <Rectangle x:Name="color_rect1" Width="50" Height="20" Fill="LightBlue" RadiusX="5" RadiusY="5" />
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Margin="0,10" Orientation="Horizontal">
                            <RadioButton x:Name="color2" VerticalContentAlignment="Center" Checked="color_Checked" Cursor="Arrow" GroupName="color">
                                <Rectangle x:Name="color_rect2" Width="50" Height="20" Fill="LightPink" RadiusX="5" RadiusY="5" />
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="color3" VerticalContentAlignment="Center" Checked="color_Checked" Cursor="Arrow" GroupName="color">
                                <Rectangle x:Name="color_rect3" Width="50" Height="20" Fill="LightSalmon" RadiusX="5" RadiusY="5" />
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </flow:RectShape>

            <flow:RectShape x:Name="flowRect1" Fill="{StaticResource DarkColorNodeBack}" LeftPortPanel="StackPanel" NodeId="node2" Position="400, 150" Size="100, 120">
                <flow:RectShape.LeftPort>
                    <flow:Port Margin="0,10,0,0" Type="In" ValueType="Color">
                        <flow:Port.RenderTransform>
                            <TranslateTransform X="4" Y="20" />
                        </flow:Port.RenderTransform>
                        <Ellipse x:Name="outJoin2" Width="8" Height="8" Fill="LightGreen" />
                    </flow:Port>
                </flow:RectShape.LeftPort>
                <Grid Width="100" Height="120">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border Width="100" Height="20" Background="{StaticResource DarkColorNodeTitle2}" CornerRadius="5,5,0,0">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="White" Text="圆形" />
                    </Border>

                    <Ellipse Name="test_ellipse" Grid.Row="1" Width="80" Height="80" Fill="LightBlue" />
                </Grid>
            </flow:RectShape>

            <flow:RectShape x:Name="flowRect2" Fill="{StaticResource DarkColorNodeBack}" LeftPortPanel="StackPanel" NodeId="node3" Position="400, 300" Size="100, 120">
                <flow:RectShape.LeftPort>
                    <flow:Port Margin="0,10,0,0" Type="In" ValueType="Color">
                        <flow:Port.RenderTransform>
                            <TranslateTransform X="4" Y="20" />
                        </flow:Port.RenderTransform>
                        <Ellipse x:Name="outJoin3" Width="8" Height="8" Fill="LightGray" />
                    </flow:Port>
                </flow:RectShape.LeftPort>

                <Grid Width="100" Height="120">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border Width="100" Height="20" Background="{StaticResource DarkColorNodeTitle3}" CornerRadius="5,5,0,0">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="White" Text="矩形" />
                    </Border>

                    <Rectangle Name="test_rectangle" Grid.Row="1" Width="80" Height="80" Fill="LightGray" />
                </Grid>
            </flow:RectShape>

            <flow:RectLinkShape
                x:Name="staticLink"
                LineType="Bezier"
                Source="node1"
                SourcreDirection="Right"
                SourcreIndex="0"
                Stroke="{StaticResource LineColor1}"
                Target="node2"
                TargetDirection="Left"
                TargetIndex="0">
                <flow:RectLinkShape.Labels>
                    <flow:LinkLabel>
                        <Grid x:Name="staticClose" Width="15" Height="15" Background="Transparent" Cursor="Arrow" MouseDown="CloseLink_MouseDown">
                            <Image Source="{StaticResource DeleteNodeIcon}" />
                        </Grid>
                    </flow:LinkLabel>
                </flow:RectLinkShape.Labels>
            </flow:RectLinkShape>

        </flow:FlowChart>
    </Grid>
</Window>

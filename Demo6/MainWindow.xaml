<Window
    x:Class="Demo6.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:flow="clr-namespace:WpfFlow;assembly=WpfFlow"
    xmlns:local="clr-namespace:Demo6"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="1200"
    Height="900"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#f6f7f8">
            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                <Border MouseDown="Border_MouseDown" Style="{StaticResource ToolItemPanel}">
                    <Image x:Name="RectShape" Source="{StaticResource RectRadiusIcon}" Style="{StaticResource ToolItem}" />
                </Border>

                <Border MouseDown="Border_MouseDown" Style="{StaticResource ToolItemPanel}">
                    <Image Name="RectRadiusShape" Source="{StaticResource RectIcon}" Style="{StaticResource ToolItem}" />
                </Border>

                <Border MouseDown="Border_MouseDown" Style="{StaticResource ToolItemPanel}">
                    <Image Source="{StaticResource CircleIcon}" Style="{StaticResource ToolItem}" />
                </Border>

                <Border MouseDown="Border_MouseDown" Style="{StaticResource ToolItemPanel}">
                    <Image Source="{StaticResource DiamondIcon}" Style="{StaticResource ToolItem}" />
                </Border>
            </WrapPanel>
        </Border>

        <Border Grid.Column="1" Padding="20" Background="#eaecee" BorderBrush="#dfe2e5" BorderThickness="1">
            <flow:FlowChart Name="FlowChart" AllowDrop="True" Drop="FlowChart_Drop">
                <flow:FlowChart.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="0" />
                </flow:FlowChart.Effect>
            </flow:FlowChart>
        </Border>
    </Grid>
</Window>
